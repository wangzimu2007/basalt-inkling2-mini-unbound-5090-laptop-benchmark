    "compaction_retries": 2,
    "max_overflow_retries": 2,
    "per_model_policy_examples": [
      {"provider": "deepseek-account", "model": "deepseek-flash", "summarizer": "deepseek-account/deepseek-flash"},
      {"provider": "ollama-local", "model": "qwen3.8:27b-abliterated", "note": "config comment: threshold about 65,536 tokens"},
      {"provider": "strata-local", "model": "qwen3.8-flash-next-iq3_s", "summarizer": "summary-guard-local/summary-guard"},
      {"provider": "basalt-local", "model": "Inkling-2-Mini-Unbound", "summarizer": "global default unless overridden"}
    ],
    "note": "The benchmark calls model APIs directly (Basalt 8095, Strata 8080, Ollama 11434), so DSH chat compaction does not alter these requests. Compaction only affects DSH conversation turns."
  }
