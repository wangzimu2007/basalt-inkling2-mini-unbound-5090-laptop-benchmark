{
  "hardware": {
    "gpu": "NVIDIA GeForce RTX 5090 Laptop GPU",
    "vram_gb": 24,
    "ram_gb": 64,
    "os": "Windows 11 x64",
    "nvidia_driver": "621.24"
  },
  "engines": {
    "basalt": {"version": "0.5.7", "port": 8095},
    "strata": {"version": "0.1.67", "port": 8080},
    "ollama": {"port": 11434}
